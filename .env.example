# Copy to .env, edit, then load it with:  set -a; source .env; set +a
# Say who you are, with a way to contact you. Many sites (Wikipedia included) ask for this.
FETCHER_USER_AGENT="your-bot-name/0.1 (+mailto:you@example.com)"
FETCHER_CONCURRENCY=10
FETCHER_LOG_LEVEL=info

# For `fetcher ask`: any OpenAI-compatible chat API. Groq has a free tier (console.groq.com/keys).
LLM_API_KEY="gsk_your_key_here"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-120b"
